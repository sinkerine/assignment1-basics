# Project environment: direnv loads a Python 3.13 toolchain and uv syncs locked deps.
if command -v nix >/dev/null 2>&1; then
  export UV_BIN="$(nix build --no-link --print-out-paths nixpkgs#uv)/bin/uv"
  export PATH="${UV_BIN%/*}:$(nix build --no-link --print-out-paths nixpkgs#python313)/bin:$PATH"
  export LD_LIBRARY_PATH="$(nix build --no-link --print-out-paths nixpkgs#stdenv.cc.cc.lib)/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
export UV_PROJECT_ENVIRONMENT="$PWD/.venv"
if [ -x "${UV_BIN:-}" ]; then
  "$UV_BIN" sync --frozen --quiet
fi
export VIRTUAL_ENV="$PWD/.venv"
export PATH="$VIRTUAL_ENV/bin:$PATH"
